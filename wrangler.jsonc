{
  "name": "intilaq",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intilaq",
      "database_id": "ff74c443-dd9c-4630-80d2-73139561c5af",
      "migrations_dir": "migrations"
    }
  ]
}

{
  "name": "intilaq",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intilaq-applications",
      // Replace with the id printed by `npx wrangler d1 create intilaq-applications` — see README.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}

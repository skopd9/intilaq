{
  "name": "intilaq",
  "compatibility_date": "2026-09-02",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intilaq-applications",
      // Replace with the id printed by `npx wrangler d1 create intilaq-applications` — see README.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
